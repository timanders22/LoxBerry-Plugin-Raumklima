#!/bin/sh
# Raumklima - regelmaessiger Abruf, alle fuenf Minuten.
#
# Kein Dauerdienst: Raumklima aendert sich in Minuten, nicht in Sekunden, und
# ein Prozess, der 288-mal am Tag ein paar Sekunden arbeitet, braucht keinen
# Waechter. Der Abstand steht zusaetzlich in den Einstellungen - ist der Takt
# groesser als fuenf Minuten, kehrt das Skript sofort wieder um.
#
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile ein.
# Ausdruecklich ueber php aufgerufen: geht bei einem misslungenen Update das
# Ausfuehrungsrecht verloren, schluege der unmittelbare Aufruf lautlos fehl.
# Die Fehlerausgabe geht NICHT nach /dev/null.
#
# Bis 0.11.2 stand hier `>/dev/null 2>&1`. Findet raumklima_abruf.php
# seine Bibliothek nicht, schreibt es "rk_lib.php wurde nicht gefunden."
# nach stderr und endet mit 2 - und ein Protokolleintrag ist dann
# unmoeglich, weil das Protokollieren selbst in rk_lib.php steckt. Ein
# Plugin, das nach einem misslungenen Update gar nicht mehr laeuft, sah
# von aussen aus wie eines, das laeuft. Die uebliche Ausgabe bleibt
# verworfen, nur die Fehlerausgabe wird aufgehoben.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron_fehler.log"
# 0.11.23 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.11.22 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
( : >>"$ERR" ) 2>/dev/null || ERR=/dev/null
php "REPLACELBPBINDIR/raumklima_abruf.php" \
    >/dev/null 2>>"$ERR"
