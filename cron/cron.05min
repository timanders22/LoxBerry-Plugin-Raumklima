#!/bin/sh
# Raumklima - regelmaessiger Abruf, alle fuenf Minuten.
#
# Kein Dauerdienst: Raumklima aendert sich in Minuten, nicht in Sekunden, und
# ein Prozess, der 288-mal am Tag ein paar Sekunden arbeitet, braucht keinen
# Waechter. Der Abstand steht zusaetzlich in den Einstellungen - ist der Takt
# groesser als fuenf Minuten, kehrt das Skript sofort wieder um.
#
# REPLACELBPBINDIR wird bei der Installation durch den bin-Pfad ersetzt.
# Ausdruecklich ueber php aufgerufen: geht bei einem misslungenen Update das
# Ausfuehrungsrecht verloren, schluege der unmittelbare Aufruf lautlos fehl.
# Die Fehlerausgabe geht NICHT nach /dev/null.
#
# Bis 0.11.2 stand hier `>/dev/null 2>&1`. Findet raumklima_abruf.php
# seine Bibliothek nicht, schreibt es "rk_lib.php wurde nicht gefunden."
# nach stderr und endet mit 2 - und ein Protokolleintrag ist dann
# unmoeglich, weil das Protokollieren selbst in rk_lib.php steckt. Ein
# Plugin, das nach einem misslungenen Update gar nicht mehr laeuft, sah
# von aussen aus wie eines, das laeuft. Die uebliche Ausgabe bleibt
# verworfen, nur die Fehlerausgabe wird aufgehoben.
php "REPLACELBPBINDIR/raumklima_abruf.php" \
    >/dev/null 2>>"REPLACELBPLOGDIR/cron_fehler.log"
