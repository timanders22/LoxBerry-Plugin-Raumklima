#!/bin/bash
# Raumklima - Deinstallation
#
# Die Deinstallation von LoxBerry entfernt nur das VERZEICHNIS
# config/plugins/<ordner>/. Eine Sicherungsdatei DANEBEN -
# config/plugins/<ordner>.backup.json - bliebe liegen. Beim WifiScanner
# enthielt so eine Datei die MAC-Adressen und Namen aller ueberwachten
# Personen. Hier stehen Raumnamen und die Adressen im Heimnetz drin; es gibt
# keinen Grund, sie liegen zu lassen.
#
# BIS 0.10.1 WAR DIE SCHLUSSMELDUNG EINE FALSCHAUSSAGE. Geloescht wurde nur
# <ordner>.backup.json; die beiden Namen, die der angehaengte Block von
# preupgrade.sh anlegt, waren hier nicht bekannt. Am 28.08.2026
# durchgespielt - danach lag noch da:
#
#   raumklima.backup.geheim.json    {"benutzer":"loxadmin","passwort":"..."}
#   raumklima.backup.raumklima.json {"raeume":[...],"quelle":"http://..."}
#   log/plugins/raumklima
#
# und das Skript meldete "Sicherungsdatei und Zugangsdaten geloescht".
#
# Jetzt werden alle Namen entfernt - auch der dritte aus 0.10.x, den es in
# 0.11.0 nicht mehr gibt, denn deinstalliert wird von einem Stand, der
# beliebig alt sein kann. Und GEZAEHLT wird, was wirklich weg ist: eine
# Schlussmeldung, die mehr behauptet als geschehen ist, ist schlimmer als
# gar keine.
# BIS 0.11.2 RECHNETE DIESES SKRIPT SEINE PFADE AUS DEM EIGENEN ABLAGEORT.
#
# Das kann in keiner Lage zugleich stimmen: `basename $SELF/..` setzt den
# Elternordner als Plugin-Ordner an, `$SELF/../../..` setzt das Skript
# drei Ebenen unter der Wurzel an - Plugin-Ordner liegen aber drei, nicht
# zwei Ebenen darunter. Gemessen am 05.09.2026 an drei Ablageorten:
#
#   data/system/uninstall/<name>   ohne und mit LBHOMEDIR:  0 geloescht
#   <plugindir>/uninstall/uninstall  mit LBHOMEDIR:         5 geloescht
#   <plugindir>/uninstall/uninstall  ohne:  BASE = <home>/bin, findet nichts
#
# Im Fehlfall meldete es trotzdem "entfernt ... darunter Zweitschriften,
# Zugangsdaten und Protokolle", und {"passwort":"..."} blieb im Klartext
# liegen. Jetzt kommen Ordner und Wurzel aus den Argumenten, die der
# Installer uebergibt - wie in postinstall.sh und preupgrade.sh -, und
# ohne brauchbare Wurzel wird abgebrochen statt Vollzug gemeldet.
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-raumklima}"
BASE="${ARGV5:-$LBHOMEDIR}"
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ]; then
    SELF=$(cd "$(dirname "$0")" && pwd)
    # config/system ist das unterscheidende Merkmal, nicht config/plugins.
    # Auf einem Rechner, auf dem Pruefstaende ohne LBHOMEDIR gelaufen
    # sind, liegen config/plugins, data/plugins und webfrontend auch im
    # Wurzelverzeichnis herum - gemessen am 05.09.2026 an C:\. Eine
    # general.json hat dort keiner angelegt; ein LoxBerry hat immer eine.
    for K in "$SELF/../../.." "$SELF/../../../.." "$SELF/../.."; do
        if [ -d "$K/config/plugins" ] && [ -d "$K/data/plugins" ] && [ -f "$K/config/system/general.json" ]; then
            BASE=$(cd "$K" && pwd)
            break
        fi
    done
fi
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ]; then
    echo "<WARNING> Die LoxBerry-Wurzel liess sich nicht bestimmen."
    echo "<WARNING> Es wurde NICHTS geloescht. Bitte von Hand entfernen:"
    echo "<WARNING>   config/plugins/raumklima.backup*.json"
    echo "<WARNING>   config/plugins/raumklima/geheim.json"
    echo "<WARNING>   data/plugins/raumklima  und  log/plugins/raumklima"
    exit 0
fi

# Die zurueckbehaltenen MQTT-Themen der Linie leeren - VOR dem Loeschen der
# Konfiguration (dort steht das Praefix). Bis 0.11.10 blieben sie nach dem
# Deinstallieren im Broker stehen, und nach jedem Neustart von Broker oder
# Gateway bekam der Miniserver sie wieder (in WSL gemessen,
# Pruefung-Raumklima-0.11.11, Faelle R14 und U7). Geleert wird ueber den Weg
# der Linie, den UDP-Eingang des Gateways, und beim Broker nachgelesen
# (rk_mqtt_leeren() in webfrontend/html/rk_lib.php; Bauart Spotpreis-Tibber
# 0.9.19). Als loxberry, nicht als root; stdin geschlossen, damit su nie auf
# eine Eingabe wartet. Seit dem Durchgang 01.10.2026 (M3) leert es auch die
# vorgemerkten frueher eingestellten Praefixe (data/plugins/<ordner>/
# mqtt_praefix_alt.json) - deshalb 120 s statt 60 s.
#
# 'timeout -k 5 60': ohne -k schickt timeout nach Ablauf nur SIGTERM - ein
# Prozess, der es nicht annimmt, hielt die Deinstallation an, und die
# Sicherungen darunter blieben liegen; mit '|| true' dahinter erschien ein
# Abbruch in der Ausgabe des Installers gar nicht (in WSL gemessen,
# Pruefung-Raumklima-0.11.11, messe_timeout.sh, Faelle K1-K7: 146 s ohne
# Meldung, der Platzhalter lief danach weiter). Bauart Weissware 0.9.34,
# uninstall/uninstall Schritt 1b. Das Leeren braucht ohne Broker etwa 6 s,
# mit vier Rueckfragen hoechstens rund 25 s - 60 s reichen.
# Rueckgabe 0-2 meldet rk_mqtt_leeren() selbst.
RK_ABRUF="$BASE/bin/plugins/$PFOLDER/raumklima_abruf.php"
if command -v php >/dev/null 2>&1 && [ -f "$RK_ABRUF" ]; then
    RK_RC=0
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
            timeout -k 5 120 php "$RK_ABRUF" --mqtt-leeren)" < /dev/null 2>&1 || RK_RC=$?
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout -k 5 120 php "$RK_ABRUF" --mqtt-leeren \
            < /dev/null 2>&1 || RK_RC=$?
    fi
    case "$RK_RC" in
        0|1|2) ;;
        124) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen wurde nach 120 s abgebrochen - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        137) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen reagierte nach 120 s nicht auf SIGTERM und wurde hart beendet (SIGKILL) - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        *) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen endete unerwartet (Rueckgabe $RK_RC) - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
    esac
else
    echo "<INFO> PHP oder raumklima_abruf.php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

# Die Marke einer Aktualisierung (<ordner>.upgrade_laeuft) liegt NEBEN dem
# Datenordner und bleibt liegen, wenn eine Installation abgebrochen ist; eine
# neu installierte Fassung setzte dann bis zu einer Stunde lang aus.
WEG=0
for F in \
    "$BASE/config/plugins/$PFOLDER.backup.json" \
    "$BASE/config/plugins/$PFOLDER.backup.geheim.json" \
    "$BASE/config/plugins/$PFOLDER.backup.raumklima.json" \
    "$BASE/config/plugins/$PFOLDER.backup.verlauf.json" \
    "$BASE/config/plugins/$PFOLDER/geheim.json" \
    "$BASE/data/plugins/$PFOLDER.upgrade_laeuft"
do
    if [ -e "$F" ]; then
        rm -f "$F" && WEG=$((WEG + 1))
    fi
done
# Die beiseitegelegten kaputten Konfigurationen (raumklima.json.kaputt.*)
# tragen dieselben Raumnamen und Adressen wie die heile Datei.
#
# Seit dem Durchgang 01.10.2026 (I4) auch: die .alt aus preinstall.sh und
# preupgrade.sh (Entscheidung 1) und die Nebendateien eines abgebrochenen
# Schreibvorgangs (*.tmp.<pid>, rk_json_schreiben()). Bis 0.11.13 blieb eine
# Nebendatei raumklima.backup.json.tmp.4242 mit dem Aktionstoken liegen, und
# die Schlussmeldung behauptete Vollzug (in WSL gemessen, Bericht installer,
# Fall G).
for F in "$BASE/config/plugins/$PFOLDER"/raumklima.json.kaputt.* \
         "$BASE/config/plugins/$PFOLDER".backup*.alt \
         "$BASE/config/plugins/$PFOLDER".backup*.tmp.* \
         "$BASE/config/plugins/$PFOLDER"/raumklima.json.tmp.* \
         "$BASE/config/plugins/$PFOLDER"/geheim.json.tmp.*; do
    [ -e "$F" ] || [ -L "$F" ] || continue
    rm -f "$F" && WEG=$((WEG + 1))
done

for D in "$BASE/data/plugins/$PFOLDER" "$BASE/log/plugins/$PFOLDER"; do
    if [ -d "$D" ]; then
        rm -rf "$D" && WEG=$((WEG + 1))
    fi
done

# Fail closed: liegt danach noch etwas da, wird es gesagt statt beschwiegen.
# Gezaehlt wird JEDE Datei <ordner>.backup* - nicht eine feste Liste, die neue
# Namen nicht kennt (I4).
REST=0
for F in "$BASE/config/plugins/$PFOLDER".backup*; do
    [ -e "$F" ] || [ -L "$F" ] || continue
    echo "<WARNING> Nicht entfernt: $F"; REST=$((REST + 1))
done

if [ "$REST" -gt 0 ]; then
    echo "<WARNING> Raumklima-Plugin entfernt, aber $REST Datei(en) blieben liegen."
    echo "<WARNING> Sie enthalten Raumnamen, Heimnetzadressen und Zugangsdaten."
    exit 0
fi
echo "<OK> Raumklima-Plugin entfernt, $WEG Datei(en) und Ordner geloescht -"
echo "<OK> darunter Zweitschriften, Zugangsdaten und Protokolle."
exit 0
