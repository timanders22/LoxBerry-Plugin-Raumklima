#!/bin/bash
# Raumklima - Deinstallation
#
# Die Deinstallation von LoxBerry entfernt nur das VERZEICHNIS
# config/plugins/<ordner>/. Eine Sicherungsdatei DANEBEN -
# config/plugins/<ordner>.backup.json - bliebe liegen. Beim WifiScanner
# enthielt so eine Datei die MAC-Adressen und Namen aller ueberwachten
# Personen. Hier stehen Raumnamen und die Adressen im Heimnetz drin; es gibt
# keinen Grund, sie liegen zu lassen.
#
# BIS 0.10.1 WAR DIE SCHLUSSMELDUNG EINE FALSCHAUSSAGE. Geloescht wurde nur
# <ordner>.backup.json; die beiden Namen, die der angehaengte Block von
# preupgrade.sh anlegt, waren hier nicht bekannt. Am 28.08.2026
# durchgespielt - danach lag noch da:
#
#   raumklima.backup.geheim.json    {"benutzer":"loxadmin","passwort":"..."}
#   raumklima.backup.raumklima.json {"raeume":[...],"quelle":"http://..."}
#   log/plugins/raumklima
#
# und das Skript meldete "Sicherungsdatei und Zugangsdaten geloescht".
#
# Jetzt werden alle Namen entfernt - auch der dritte aus 0.10.x, den es in
# 0.11.0 nicht mehr gibt, denn deinstalliert wird von einem Stand, der
# beliebig alt sein kann. Und GEZAEHLT wird, was wirklich weg ist: eine
# Schlussmeldung, die mehr behauptet als geschehen ist, ist schlimmer als
# gar keine.
# BIS 0.11.2 RECHNETE DIESES SKRIPT SEINE PFADE AUS DEM EIGENEN ABLAGEORT.
#
# Das kann in keiner Lage zugleich stimmen: `basename $SELF/..` setzt den
# Elternordner als Plugin-Ordner an, `$SELF/../../..` setzt das Skript
# drei Ebenen unter der Wurzel an - Plugin-Ordner liegen aber drei, nicht
# zwei Ebenen darunter. Gemessen am 05.09.2026 an drei Ablageorten:
#
#   data/system/uninstall/<name>   ohne und mit LBHOMEDIR:  0 geloescht
#   <plugindir>/uninstall/uninstall  mit LBHOMEDIR:         5 geloescht
#   <plugindir>/uninstall/uninstall  ohne:  BASE = <home>/bin, findet nichts
#
# Im Fehlfall meldete es trotzdem "entfernt ... darunter Zweitschriften,
# Zugangsdaten und Protokolle", und {"passwort":"..."} blieb im Klartext
# liegen. Jetzt kommen Ordner und Wurzel aus den Argumenten, die der
# Installer uebergibt - wie in postinstall.sh und preupgrade.sh -, und
# ohne brauchbare Wurzel wird abgebrochen statt Vollzug gemeldet.
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-raumklima}"
BASE="${ARGV5:-$LBHOMEDIR}"
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ]; then
    SELF=$(cd "$(dirname "$0")" && pwd)
    # config/system ist das unterscheidende Merkmal, nicht config/plugins.
    # Auf einem Rechner, auf dem Pruefstaende ohne LBHOMEDIR gelaufen
    # sind, liegen config/plugins, data/plugins und webfrontend auch im
    # Wurzelverzeichnis herum - gemessen am 05.09.2026 an C:\. Eine
    # general.json hat dort keiner angelegt; ein LoxBerry hat immer eine.
    for K in "$SELF/../../.." "$SELF/../../../.." "$SELF/../.."; do
        if [ -d "$K/config/plugins" ] && [ -d "$K/data/plugins" ] && [ -f "$K/config/system/general.json" ]; then
            BASE=$(cd "$K" && pwd)
            break
        fi
    done
fi
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ]; then
    echo "<WARNING> Die LoxBerry-Wurzel liess sich nicht bestimmen."
    echo "<WARNING> Es wurde NICHTS geloescht. Bitte von Hand entfernen:"
    echo "<WARNING>   config/plugins/raumklima.backup*.json"
    echo "<WARNING>   config/plugins/raumklima/geheim.json"
    echo "<WARNING>   data/plugins/raumklima  und  log/plugins/raumklima"
    exit 0
fi

WEG=0
for F in \
    "$BASE/config/plugins/$PFOLDER.backup.json" \
    "$BASE/config/plugins/$PFOLDER.backup.geheim.json" \
    "$BASE/config/plugins/$PFOLDER.backup.raumklima.json" \
    "$BASE/config/plugins/$PFOLDER.backup.verlauf.json" \
    "$BASE/config/plugins/$PFOLDER/geheim.json"
do
    if [ -e "$F" ]; then
        rm -f "$F" && WEG=$((WEG + 1))
    fi
done
# Die beiseitegelegten kaputten Konfigurationen (raumklima.json.kaputt.*)
# tragen dieselben Raumnamen und Adressen wie die heile Datei.
for F in "$BASE/config/plugins/$PFOLDER"/raumklima.json.kaputt.*; do
    [ -e "$F" ] || continue
    rm -f "$F" && WEG=$((WEG + 1))
done

for D in "$BASE/data/plugins/$PFOLDER" "$BASE/log/plugins/$PFOLDER"; do
    if [ -d "$D" ]; then
        rm -rf "$D" && WEG=$((WEG + 1))
    fi
done

# Fail closed: liegt danach noch etwas da, wird es gesagt statt beschwiegen.
REST=0
for F in \
    "$BASE/config/plugins/$PFOLDER.backup.json" \
    "$BASE/config/plugins/$PFOLDER.backup.geheim.json" \
    "$BASE/config/plugins/$PFOLDER.backup.raumklima.json" \
    "$BASE/config/plugins/$PFOLDER.backup.verlauf.json"
do
    [ -e "$F" ] && { echo "<WARNING> Nicht entfernt: $F"; REST=$((REST + 1)); }
done

if [ "$REST" -gt 0 ]; then
    echo "<WARNING> Raumklima-Plugin entfernt, aber $REST Datei(en) blieben liegen."
    echo "<WARNING> Sie enthalten Raumnamen, Heimnetzadressen und Zugangsdaten."
    exit 0
fi
echo "<OK> Raumklima-Plugin entfernt, $WEG Datei(en) und Ordner geloescht -"
echo "<OK> darunter Zweitschriften, Zugangsdaten und Protokolle."
exit 0
